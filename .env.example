# Obrigatória para o modo de IA com modelo de linguagem.
OPENAI_API_KEY=

# Opcional: endpoint OpenAI ou compatível. O padrão é https://api.openai.com/v1
OPENAI_API_BASE=https://api.openai.com/v1

# Opcional: modelo disponível no provedor configurado.
SEGURAMENTE_LLM_MODEL=gpt-4.1-mini
SEGURAMENTE_LLM_TIMEOUT=30
